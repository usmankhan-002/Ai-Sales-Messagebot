# Copy this file to `.env` and fill in your values.
# The OpenAI API key is required. It must never be committed.

OPENAI_API_KEY=sk-...

AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.6

# Optional: if set, requests to /v1/ai/sales-message must carry
# `Authorization: Bearer <token>`. Leave empty to disable auth (demo mode).
AI_API_TOKEN=
# Optional: Neon Postgres. Use the *pooled* connection string from
# Neon Dashboard -> Connect (host contains "-pooler"). Never commit it.
DATABASE_URL=

# Drafts and rankings hold client details: deleted after this many days (0 = keep).
DRAFT_RETENTION_DAYS=90
# Usage log (no client details): deleted after this many days (0 = keep).
USAGE_RETENTION_DAYS=365
